# Get these from NRG Cloud: https://cloud.nrgsystems.com/data-manager/api-setup
CLIENT_ID=""
CLIENT_SECRET=""

# Where your Projects folder lives. Environment variables are expanded, so
# %OneDriveCommercial% follows the work OneDrive across machines. Leave this
# unset to use the Projects folder in whatever Documents folder Windows
# reports -- correct only if you have a single OneDrive account signed in.
SE_PROJECTS_DIR="%OneDriveCommercial%\Documents\Projects"
